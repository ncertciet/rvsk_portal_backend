{
  "info": {
    "name": "RVSK Backend - NestJS Services",
    "description": "Complete API collection for rvsk-backend NestJS monorepo.\n\nApps:\n- Portal (8091): Auth, Users, RBAC, Grievances, Forms, Gallery, VSK, Home\n- RVSK6A (8083): Attendance Dashboard, Filters\n- Schemes (8082): National Education Schemes KPIs & Dashboards\n\nUsage:\n1. Run 'Login - Super Admin' first to get a token\n2. Token auto-saves to collection variable {{token}}\n3. All authenticated requests use Bearer {{token}}",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "portal_url", "value": "http://localhost:8091" },
    { "key": "rvsk6a_url", "value": "http://localhost:8083" },
    { "key": "schemes_url", "value": "http://localhost:8082" },
    { "key": "token", "value": "" },
    { "key": "user_id", "value": "" },
    { "key": "form_id", "value": "" },
    { "key": "grievance_id", "value": "" },
    { "key": "module_id", "value": "" },
    { "key": "page_id", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "01 - Authentication",
      "item": [
        {
          "name": "Login - Super Admin",
          "event": [{ "listen": "test", "script": { "exec": ["var res = pm.response.json();", "if (res.accessToken) { pm.collectionVariables.set('token', res.accessToken); }", "if (res.user && res.user.id) { pm.collectionVariables.set('user_id', res.user.id); }", "pm.test('Login successful', function() { pm.response.to.have.status(200); });"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"superadmin\",\n  \"password\": \"Admin@123\"\n}" },
            "url": { "raw": "{{portal_url}}/api/v1/auth/login", "host": ["{{portal_url}}"], "path": ["api", "v1", "auth", "login"] }
          }
        },
        {
          "name": "Login - RVSK Admin",
          "event": [{ "listen": "test", "script": { "exec": ["var res = pm.response.json();", "if (res.accessToken) { pm.collectionVariables.set('token', res.accessToken); }"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"rvskadmin\",\n  \"password\": \"Admin@123\"\n}" },
            "url": { "raw": "{{portal_url}}/api/v1/auth/login", "host": ["{{portal_url}}"], "path": ["api", "v1", "auth", "login"] }
          }
        },
        {
          "name": "Login - State Admin",
          "event": [{ "listen": "test", "script": { "exec": ["var res = pm.response.json();", "if (res.accessToken) { pm.collectionVariables.set('token', res.accessToken); }"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"stateadmin_mh\",\n  \"password\": \"Admin@123\"\n}" },
            "url": { "raw": "{{portal_url}}/api/v1/auth/login", "host": ["{{portal_url}}"], "path": ["api", "v1", "auth", "login"] }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"paste-refresh-token-here\"\n}" },
            "url": { "raw": "{{portal_url}}/api/v1/auth/refresh", "host": ["{{portal_url}}"], "path": ["api", "v1", "auth", "refresh"] }
          }
        },
        {
          "name": "Get Current User (me)",
          "request": { "method": "GET", "url": { "raw": "{{portal_url}}/api/v1/auth/me", "host": ["{{portal_url}}"], "path": ["api", "v1", "auth", "me"] } }
        },
        {
          "name": "Get Profile",
          "request": { "method": "GET", "url": { "raw": "{{portal_url}}/api/v1/auth/profile", "host": ["{{portal_url}}"], "path": ["api", "v1", "auth", "profile"] } }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"oldPassword\": \"Admin@123\",\n  \"newPassword\": \"NewPass@456\"\n}" },
            "url": { "raw": "{{portal_url}}/api/v1/auth/change-password", "host": ["{{portal_url}}"], "path": ["api", "v1", "auth", "change-password"] }
          }
        },
        {
          "name": "Logout",
          "request": { "method": "POST", "url": { "raw": "{{portal_url}}/api/v1/auth/logout", "host": ["{{portal_url}}"], "path": ["api", "v1", "auth", "logout"] } }
        }
      ]
    },
    {
      "name": "02 - User Management",
      "item": [
        {
          "name": "List Users",
          "request": { "method": "GET", "url": { "raw": "{{portal_url}}/api/v1/users?role=&stateCode=&search=", "host": ["{{portal_url}}"], "path": ["api", "v1", "users"], "query": [{ "key": "role", "value": "" }, { "key": "stateCode", "value": "" }, { "key": "search", "value": "" }] } }
        },
        {
          "name": "Get User by ID",
          "request": { "method": "GET", "url": { "raw": "{{portal_url}}/api/v1/users/{{user_id}}", "host": ["{{portal_url}}"], "path": ["api", "v1", "users", "{{user_id}}"] } }
        },
        {
          "name": "Create User",
          "event": [{ "listen": "test", "script": { "exec": ["var res = pm.response.json();", "if (res.id) { pm.collectionVariables.set('user_id', res.id); }"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"testuser_01\",\n  \"displayName\": \"Test User One\",\n  \"role\": \"State_Admin\",\n  \"stateCode\": \"MH\",\n  \"email\": \"testuser01@rvsk.gov.in\"\n}" },
            "url": { "raw": "{{portal_url}}/api/v1/users/create", "host": ["{{portal_url}}"], "path": ["api", "v1", "users", "create"] }
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"displayName\": \"Updated Test User\",\n  \"role\": \"Analytics_User\"\n}" },
            "url": { "raw": "{{portal_url}}/api/v1/users/{{user_id}}", "host": ["{{portal_url}}"], "path": ["api", "v1", "users", "{{user_id}}"] }
          }
        },
        {
          "name": "Reset Password",
          "request": { "method": "PUT", "url": { "raw": "{{portal_url}}/api/v1/users/{{user_id}}/reset-password", "host": ["{{portal_url}}"], "path": ["api", "v1", "users", "{{user_id}}", "reset-password"] } }
        },
        {
          "name": "Unlock Account",
          "request": { "method": "PUT", "url": { "raw": "{{portal_url}}/api/v1/users/{{user_id}}/unlock", "host": ["{{portal_url}}"], "path": ["api", "v1", "users", "{{user_id}}", "unlock"] } }
        },
        {
          "name": "Toggle Active",
          "request": { "method": "PUT", "url": { "raw": "{{portal_url}}/api/v1/users/{{user_id}}/toggle-active", "host": ["{{portal_url}}"], "path": ["api", "v1", "users", "{{user_id}}", "toggle-active"] } }
        },
        {
          "name": "Deactivate User",
          "request": { "method": "PUT", "url": { "raw": "{{portal_url}}/api/v1/users/{{user_id}}/deactivate", "host": ["{{portal_url}}"], "path": ["api", "v1", "users", "{{user_id}}", "deactivate"] } }
        },
        {
          "name": "Delete User (Soft)",
          "request": { "method": "DELETE", "url": { "raw": "{{portal_url}}/api/v1/users/{{user_id}}", "host": ["{{portal_url}}"], "path": ["api", "v1", "users", "{{user_id}}"] } }
        }
      ]
    },
    {
      "name": "03 - RBAC (Modules, Pages, Permissions)",
      "item": [
        {
          "name": "List Modules",
          "event": [{ "listen": "test", "script": { "exec": ["var res = pm.response.json();", "if (res.length > 0) { pm.collectionVariables.set('module_id', res[0].id); }"] } }],
          "request": { "method": "GET", "url": { "raw": "{{portal_url}}/api/v1/modules?includeInactive=true", "host": ["{{portal_url}}"], "path": ["api", "v1", "modules"], "query": [{ "key": "includeInactive", "value": "true" }] } }
        },
        {
          "name": "Create Module",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"moduleCode\": \"TEST_MODULE\",\n  \"moduleName\": \"Test Module\",\n  \"icon\": \"Science\",\n  \"displayOrder\": 99\n}" },
            "url": { "raw": "{{portal_url}}/api/v1/modules", "host": ["{{portal_url}}"], "path": ["api", "v1", "modules"] }
          }
        },
        {
          "name": "Update Module",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"moduleName\": \"Updated Module Name\",\n  \"displayOrder\": 10\n}" },
            "url": { "raw": "{{portal_url}}/api/v1/modules/{{module_id}}", "host": ["{{portal_url}}"], "path": ["api", "v1", "modules", "{{module_id}}"] }
          }
        },
        {
          "name": "Deactivate Module",
          "request": { "method": "PATCH", "url": { "raw": "{{portal_url}}/api/v1/modules/{{module_id}}/deactivate", "host": ["{{portal_url}}"], "path": ["api", "v1", "modules", "{{module_id}}", "deactivate"] } }
        },
        {
          "name": "Activate Module",
          "request": { "method": "PATCH", "url": { "raw": "{{portal_url}}/api/v1/modules/{{module_id}}/activate", "host": ["{{portal_url}}"], "path": ["api", "v1", "modules", "{{module_id}}", "activate"] } }
        },
        {
          "name": "List Pages",
          "event": [{ "listen": "test", "script": { "exec": ["var res = pm.response.json();", "if (res.length > 0) { pm.collectionVariables.set('page_id', res[0].id); }"] } }],
          "request": { "method": "GET", "url": { "raw": "{{portal_url}}/api/v1/pages?includeInactive=true", "host": ["{{portal_url}}"], "path": ["api", "v1", "pages"], "query": [{ "key": "includeInactive", "value": "true" }] } }
        },
        {
          "name": "List Pages by Module",
          "request": { "method": "GET", "url": { "raw": "{{portal_url}}/api/v1/pages/by-module/{{module_id}}", "host": ["{{portal_url}}"], "path": ["api", "v1", "pages", "by-module", "{{module_id}}"] } }
        },
        {
          "name": "Create Page",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"moduleId\": \"{{module_id}}\",\n  \"pageCode\": \"TEST_PAGE\",\n  \"pageName\": \"Test Page\",\n  \"routePath\": \"/rvsk/dashboard/test\",\n  \"icon\": \"Science\",\n  \"displayOrder\": 1\n}" },
            "url": { "raw": "{{portal_url}}/api/v1/pages", "host": ["{{portal_url}}"], "path": ["api", "v1", "pages"] }
          }
        },
        {
          "name": "Update Page",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"pageName\": \"Updated Page Name\",\n  \"displayOrder\": 5\n}" },
            "url": { "raw": "{{portal_url}}/api/v1/pages/{{page_id}}", "host": ["{{portal_url}}"], "path": ["api", "v1", "pages", "{{page_id}}"] }
          }
        },
        {
          "name": "Get Menu Tree",
          "request": { "method": "GET", "url": { "raw": "{{portal_url}}/api/v1/menu/tree", "host": ["{{portal_url}}"], "path": ["api", "v1", "menu", "tree"] } }
        },
        {
          "name": "Get Role Defaults (Super_Admin)",
          "request": { "method": "GET", "url": { "raw": "{{portal_url}}/api/v1/permissions/role-defaults/Super_Admin", "host": ["{{portal_url}}"], "path": ["api", "v1", "permissions", "role-defaults", "Super_Admin"] } }
        },
        {
          "name": "Set Role Page Default",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"role\": \"State_Admin\",\n  \"pageId\": \"{{page_id}}\",\n  \"permissions\": {\n    \"canView\": true,\n    \"canEdit\": true,\n    \"canExport\": false,\n    \"canDelete\": false\n  }\n}" },
            "url": { "raw": "{{portal_url}}/api/v1/permissions/role-defaults", "host": ["{{portal_url}}"], "path": ["api", "v1", "permissions", "role-defaults"] }
          }
        },
        {
          "name": "Get User Overrides",
          "request": { "method": "GET", "url": { "raw": "{{portal_url}}/api/v1/permissions/user-overrides/{{user_id}}", "host": ["{{portal_url}}"], "path": ["api", "v1", "permissions", "user-overrides", "{{user_id}}"] } }
        },
        {
          "name": "Get My Access",
          "request": { "method": "GET", "url": { "raw": "{{portal_url}}/api/v1/permissions/my-access", "host": ["{{portal_url}}"], "path": ["api", "v1", "permissions", "my-access"] } }
        }
      ]
    },
    {
      "name": "04 - Grievance Management",
      "item": [
        {
          "name": "Get Categories (Public)",
          "request": { "method": "GET", "url": { "raw": "{{portal_url}}/api/v1/grievances/categories", "host": ["{{portal_url}}"], "path": ["api", "v1", "grievances", "categories"] }, "auth": { "type": "noauth" } }
        },
        {
          "name": "Get Dashboard KPIs",
          "request": { "method": "GET", "url": { "raw": "{{portal_url}}/api/v1/grievances/dashboard", "host": ["{{portal_url}}"], "path": ["api", "v1", "grievances", "dashboard"] } }
        },
        {
          "name": "Get Notification Count",
          "request": { "method": "GET", "url": { "raw": "{{portal_url}}/api/v1/grievances/notifications/count", "host": ["{{portal_url}}"], "path": ["api", "v1", "grievances", "notifications", "count"] } }
        },
        {
          "name": "Create Grievance",
          "event": [{ "listen": "test", "script": { "exec": ["var res = pm.response.json();", "if (res.id) { pm.collectionVariables.set('grievance_id', res.id); }"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"category\": \"INFRASTRUCTURE\",\n  \"subCategory\": \"BUILDING\",\n  \"subject\": \"Test Grievance - Broken classroom roof\",\n  \"description\": \"The classroom roof in Block A is leaking during rain. This needs urgent repair.\"\n}" },
            "url": { "raw": "{{portal_url}}/api/v1/grievances", "host": ["{{portal_url}}"], "path": ["api", "v1", "grievances"] }
          }
        },
        {
          "name": "List Grievances",
          "request": { "method": "GET", "url": { "raw": "{{portal_url}}/api/v1/grievances?page=0&size=20&search=&status=&category=", "host": ["{{portal_url}}"], "path": ["api", "v1", "grievances"], "query": [{ "key": "page", "value": "0" }, { "key": "size", "value": "20" }, { "key": "search", "value": "" }, { "key": "status", "value": "" }, { "key": "category", "value": "" }] } }
        },
        {
          "name": "Get Grievance Detail",
          "request": { "method": "GET", "url": { "raw": "{{portal_url}}/api/v1/grievances/{{grievance_id}}", "host": ["{{portal_url}}"], "path": ["api", "v1", "grievances", "{{grievance_id}}"] } }
        },
        {
          "name": "Update Grievance Status",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"newStatus\": \"IN_PROGRESS\",\n  \"comment\": \"Assigning to district team for investigation.\"\n}" },
            "url": { "raw": "{{portal_url}}/api/v1/grievances/{{grievance_id}}/status", "host": ["{{portal_url}}"], "path": ["api", "v1", "grievances", "{{grievance_id}}", "status"] }
          }
        },
        {
          "name": "Add Response to Grievance",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"responseText\": \"We have dispatched a repair team. Expected completion within 5 business days.\"\n}" },
            "url": { "raw": "{{portal_url}}/api/v1/grievances/{{grievance_id}}/responses", "host": ["{{portal_url}}"], "path": ["api", "v1", "grievances", "{{grievance_id}}", "responses"] }
          }
        },
        {
          "name": "Add Internal Note",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"note\": \"District admin confirmed budget allocation for this repair.\"\n}" },
            "url": { "raw": "{{portal_url}}/api/v1/grievances/{{grievance_id}}/notes", "host": ["{{portal_url}}"], "path": ["api", "v1", "grievances", "{{grievance_id}}", "notes"] }
          }
        },
        {
          "name": "Close Grievance",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"comment\": \"Issue resolved. Roof repaired.\"\n}" },
            "url": { "raw": "{{portal_url}}/api/v1/grievances/{{grievance_id}}/close", "host": ["{{portal_url}}"], "path": ["api", "v1", "grievances", "{{grievance_id}}", "close"] }
          }
        }
      ]
    },
    {
      "name": "05 - Form Builder",
      "item": [
        {
          "name": "Create Form",
          "event": [{ "listen": "test", "script": { "exec": ["var res = pm.response.json();", "if (res.id) { pm.collectionVariables.set('form_id', res.id); }"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"School Infrastructure Survey 2025\",\n  \"description\": \"Annual infrastructure audit form for all state schools\",\n  \"category\": \"INFRASTRUCTURE\"\n}" },
            "url": { "raw": "{{portal_url}}/api/v1/forms", "host": ["{{portal_url}}"], "path": ["api", "v1", "forms"] }
          }
        },
        {
          "name": "List Forms",
          "request": { "method": "GET", "url": { "raw": "{{portal_url}}/api/v1/forms?status=&search=&page=0&size=20", "host": ["{{portal_url}}"], "path": ["api", "v1", "forms"], "query": [{ "key": "status", "value": "" }, { "key": "search", "value": "" }, { "key": "page", "value": "0" }, { "key": "size", "value": "20" }] } }
        },
        {
          "name": "Get Form by ID",
          "request": { "method": "GET", "url": { "raw": "{{portal_url}}/api/v1/forms/{{form_id}}", "host": ["{{portal_url}}"], "path": ["api", "v1", "forms", "{{form_id}}"] } }
        },
        {
          "name": "Add Question to Form",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"questionText\": \"How many classrooms have proper ventilation?\",\n  \"questionType\": \"NUMBER\",\n  \"isRequired\": true,\n  \"displayOrder\": 1\n}" },
            "url": { "raw": "{{portal_url}}/api/v1/forms/{{form_id}}/questions", "host": ["{{portal_url}}"], "path": ["api", "v1", "forms", "{{form_id}}", "questions"] }
          }
        },
        {
          "name": "Get Questions",
          "request": { "method": "GET", "url": { "raw": "{{portal_url}}/api/v1/forms/{{form_id}}/questions", "host": ["{{portal_url}}"], "path": ["api", "v1", "forms", "{{form_id}}", "questions"] } }
        },
        {
          "name": "Publish Form",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"targetStates\": [\"MH\", \"KA\", \"TN\"],\n  \"deadline\": \"2025-12-31\"\n}" },
            "url": { "raw": "{{portal_url}}/api/v1/forms/{{form_id}}/publish", "host": ["{{portal_url}}"], "path": ["api", "v1", "forms", "{{form_id}}", "publish"] }
          }
        },
        {
          "name": "Submit Response",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"answers\": [\n    { \"questionId\": \"q1-uuid\", \"value\": \"15\" }\n  ]\n}" },
            "url": { "raw": "{{portal_url}}/api/v1/forms/{{form_id}}/responses", "host": ["{{portal_url}}"], "path": ["api", "v1", "forms", "{{form_id}}", "responses"] }
          }
        },
        {
          "name": "Get Responses",
          "request": { "method": "GET", "url": { "raw": "{{portal_url}}/api/v1/forms/{{form_id}}/responses?page=0&size=20", "host": ["{{portal_url}}"], "path": ["api", "v1", "forms", "{{form_id}}", "responses"], "query": [{ "key": "page", "value": "0" }, { "key": "size", "value": "20" }] } }
        },
        {
          "name": "Get My Response",
          "request": { "method": "GET", "url": { "raw": "{{portal_url}}/api/v1/forms/{{form_id}}/my-response", "host": ["{{portal_url}}"], "path": ["api", "v1", "forms", "{{form_id}}", "my-response"] } }
        },
        {
          "name": "Close Form",
          "request": { "method": "POST", "url": { "raw": "{{portal_url}}/api/v1/forms/{{form_id}}/close", "host": ["{{portal_url}}"], "path": ["api", "v1", "forms", "{{form_id}}", "close"] } }
        }
      ]
    },
    {
      "name": "06 - Attendance (RVSK6A - Port 8083)",
      "item": [
        {
          "name": "Integration Coverage",
          "request": { "method": "GET", "url": { "raw": "{{rvsk6a_url}}/api/v1/attendance/integration-coverage", "host": ["{{rvsk6a_url}}"], "path": ["api", "v1", "attendance", "integration-coverage"] } }
        },
